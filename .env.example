# Chép thành .env (đã có trong .gitignore — repo public, KHÔNG commit khoá).
# GEMINI_*: chỉ dùng cho `npm run gen` (soạn câu khái niệm bằng Gemini, D27); app không cần.
GEMINI_API_KEY=
# Tuỳ chọn — mặc định gemini-2.5-flash
GEMINI_MODEL=
# Tuỳ chọn — thư mục đồng bộ tiến độ giữa các máy (D37). Để trống = tự tìm iCloud Drive / Google Drive /
# OneDrive / Dropbox. Đặt đường dẫn tuyệt đối để tự chọn, hoặc "off" để tắt.
STUDY_SYNC_DIR=
