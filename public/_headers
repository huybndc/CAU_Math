# Cloudflare Workers Assets: header bảo mật cho mọi trang của CAU_Math chạy riêng (không đăng nhập, không gọi máy chủ ngoài).
# sha256 = inline script: light/dark setup in each course index.html. The root index.html has no script: it uses meta refresh, so its redirect target can change without a new hash.
# Sửa các đoạn đó ⇒ tính lại hash (shared/tests/headers.test.js báo lệch). style 'unsafe-inline': KaTeX dùng style gắn trực tiếp.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-34jWaVqrOQMZUITDONYk5JkaJBctDr/Wo/gD9jAObAE='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
