{
  "name": "study-apps",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Ba app ôn tập chạy localhost: Logic Circuit, Linear Algebra, Discrete Math",
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/check-file-sizes.mjs .",
    "launcher": "bash scripts/make-launcher.sh",
    "gen": "vite-node scripts/gen/generate.js",
    "gen:review": "vite-node scripts/gen/review.js",
    "design:check": "node scripts/design-check.mjs --subjects index.html home shared",
    "mutate": "node scripts/mutation-check.mjs",
    "gen:subjects": "node scripts/gen-subjects.mjs",
    "gen:c": "node scripts/gen-c-bank.mjs",
    "gate": "npm test && npm run check && npm run design:check && npm run build && npm run ui:audit",
    "ui:audit": "playwright test",
    "deploy": "npm run build && npx --yes wrangler@4 deploy"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/stix-two-text": "^5.3.0",
    "katex": "^0.18.10",
    "marked": "^15.0.12"
  }
}
